# mako. Tokyo Night, matching waybar/foot/fuzzel.

font=JetBrainsMono Nerd Font 11
background-color=#1f2335f0
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #3d59a1

width=380
height=140
margin=12
padding=14
border-size=2
border-radius=8
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=0

anchor=top-right
layer=overlay

[urgency=low]
border-color=#565f89
text-color=#a9b1d6

[urgency=normal]
border-color=#7aa2f7

# Critical notifications stay put until dismissed.
[urgency=critical]
background-color=#f7768e
text-color=#1a1b26
border-color=#ff9e64
border-size=3
default-timeout=0
font=JetBrainsMono Nerd Font Bold 12
